# Copy this file to .env.local and fill in your real values.

# The public URL for this quiz. It is used to create branded /go/... campaign
# links and to load both partnership logos in the designed Resend emails.
NEXT_PUBLIC_SITE_URL=https://your-quiz-domain.example

# Optional marketing pixels. They load only after a visitor consents, and the
# app never sends quiz answers, names, phone numbers or email addresses to them.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Add this only after you create a Google Ads conversion action for a saved lead.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Add this only after you create a LinkedIn lead conversion.
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
NEXT_PUBLIC_MICROSOFT_UET_TAG_ID=

# /admin dashboard. Both values are required before /admin can be accessed.
# Use a long, unique password and a random session secret of at least 32 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-characters

# Required for a serverless deployment. Create a Supabase project, run
# supabase/schema.sql in its SQL Editor, then add these server-only values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only needed if you want email notifications/confirmations.
# Get a key at resend.com, then verify your sending domain there.
# Leave RESEND_API_KEY blank to stay WhatsApp-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@send.ifmkindredpathfertilitycentre.com
KINDRED_PATH_WHATSAPP_NUMBER=2349132347955

# Optional — comma-separated list. If left blank, the app already sends
# team notifications to info@kindredpathifm.com, operations@kindredpathifm.com,
# and negtech1@gmail.com by default (see app/api/leads/route.ts).
LEAD_NOTIFICATION_EMAIL=
